# Server
PORT=3000

# Gemini API for AI content + competitive analysis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ENABLE_AI_ANALYSIS=true

# Drupal demo site population
DRUPAL_BASE_URL=https://demo.acquia-sites.com
DRUPAL_USERNAME=admin
DRUPAL_PASSWORD=
ENABLE_DRUPAL_POPULATION=true

# Set by Docker/Railway — uses system Chromium instead of Puppeteer's bundled Chrome
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
