# Server
PORT=3000

# Anthropic API (optional — falls back to static competitive data)
ANTHROPIC_API_KEY=sk-ant-...
ENABLE_AI_ANALYSIS=false

# Drupal demo site population
DRUPAL_BASE_URL=https://demo.acquia-sites.com
DRUPAL_USERNAME=admin
DRUPAL_PASSWORD=
ENABLE_DRUPAL_POPULATION=true

# Set by Docker/Railway — uses system Chromium instead of Puppeteer's bundled Chrome
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
